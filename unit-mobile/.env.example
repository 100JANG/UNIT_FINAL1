# UNIT mobile (Expo) — env example
# Copy this file to `.env` (gitignored). Expo automatically loads variables prefixed
# with `EXPO_PUBLIC_*` and exposes them at runtime via `process.env.EXPO_PUBLIC_*`.
#
# NOTE: This is a React Native + Expo project, not a Vite project.
# The integration spec referenced VITE_API_BASE_URL / VITE_ENABLE_RTDATABASE; the
# equivalents below follow Expo's env convention. See docs/integration/00_INTEGRATION_AUDIT.md.

# Backend REST API base URL.
# - Android emulator -> http://10.0.2.2:8080/v1
# - iOS simulator   -> http://localhost:8080/v1
# - Physical device -> http://<your-LAN-IP>:8080/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# RTDB read subscription is OFF in this connection cycle (REST-only).
# Flip to "true" only after RTDB subscription is wired (post-Feed cycle).
EXPO_PUBLIC_ENABLE_RTDATABASE=false

# Firebase placeholders — leave as-is; only fill `.env` (never commit).
# These are read by future RTDB read-subscription wiring (cycle N+1).
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me
EXPO_PUBLIC_FIREBASE_DATABASE_URL=replace-me
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-me
